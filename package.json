    "fake-indexeddb": "^6.0.0",
    "globals": "^15.14.0",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.1",
    "jspdf": "4.2.1",
    "prettier": "^3.4.2",
    "vitest": "^2.1.8"
  }
}
