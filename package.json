    "schema:build": "node scripts/build-schema.mjs",
    "schema:check": "node scripts/build-schema.mjs --check",
    "test:e2e": "playwright test",
    "vendor:check": "node scripts/check-vendor.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
