  "description": "Outillage de développement uniquement (lint, tests). L'application elle-même n'a aucune dépendance npm : elle est servie telle quelle depuis dist/.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
